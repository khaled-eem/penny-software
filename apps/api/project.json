{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cross-env NODE_ENV=production webpack-cli --config apps/api/webpack.config.js"
      },
      "configurations": {
        "development": {
          "command": "cross-env NODE_ENV=development webpack-cli --config apps/api/webpack.config.js"
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "api:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build"
        }
      }
    }
  }
}
